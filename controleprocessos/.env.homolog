# =======================================
# Ambiente: Homologação
# =======================================
DJANGO_ENV=homolog
DEBUG=False

# URL base (host/porta homolog)
SITE_URL=http://127.0.0.1:8001

# Identidade de cookies (evita colisão com dev)
SESSION_COOKIE_NAME=sessionid_homolog
CSRF_COOKIE_NAME=csrftoken_homolog

# Segurança
SECRET_KEY=secreta_654321

# ======================
# DATABASE
# ======================
# ATENÇÃO:
# - Você informou que estes nomes existem exatamente assim no PostgreSQL.
# - Portanto, os mantenho conforme especificado.
DB_NAME=ControleProcessos-Homolog
DB_USER=SEGER
DB_PASSWORD=seger@1
DB_HOST=127.0.0.1
DB_PORT=5432

# ======================
# EMAIL
# ======================
EMAIL_HOST=10.243.32.23
EMAIL_PORT=25

EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

# Como no DEV, deixe vazio se o servidor SMTP não exigir login.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

DEFAULT_FROM_EMAIL="SIGEMP <elpi@seger.es.gov.br>"

# ======================
# LOG (opcional)
# ======================
LOG_LEVEL=INFO